{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "checkJs": true,
        "strict": true,
        "noImplicitAny": true,
        "exactOptionalPropertyTypes": true,
        "lib": ["ESNext", "DOM", "WebWorker"],
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["src/**/*.js"]
}
