{
    "name": "zozlib-js-tooling",
    "version": "0.1.0",
    "private": true,
    "description": "Minimal formatting tooling for owned JS/C files",
    "license": "Zlib",
    "type": "module",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "npm run build:c",
        "build:c": "([ -x ./nob ] || cc -x c nob.c -o nob) && ./nob",
        "build:c:bear": "if command -v bear >/dev/null 2>&1; then bear -- npm run build; else npm run build; fi",
        "typecheck": "tsc -p tsconfig.typecheck.json",
        "format": "npm run format:js && npm run format:c",
        "format:check": "npm run format:js:check && npm run format:c:check",
        "format:js": "prettier -w .",
        "format:js:check": "prettier -c .",
        "format:c": "git ls-files -z -- '*.c' '*.h' | xargs -0 clang-format -style=file -i",
        "format:c:check": "git ls-files -z -- '*.c' '*.h' | xargs -0 clang-format --dry-run --Werror -style=file"
    },
    "devDependencies": {
        "prettier": "^3.0.0",
        "typescript": "^5.9.3"
    },
    "packageManager": "pnpm@10.30.0+sha512.2b5753de015d480eeb88f5b5b61e0051f05b4301808a82ec8b840c9d2adf7748eb352c83f5c1593ca703ff1017295bc3fdd3119abb9686efc96b9fcb18200937"
}
